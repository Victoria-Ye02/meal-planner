// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

// Note: the CLI reads the connection URL from prisma.config.ts, not from a `url` field here.
datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  dietaryPreferences String[]
  allergies          String[]
  createdAt          DateTime @default(now())

  recipes          Recipe[]
  savedRecipes     SavedRecipe[]
  mealPlans        MealPlan[]
  aiGenerationLogs AiGenerationLog[]
}

/// One row per AI recipe-generation call. Used only to enforce a per-user
/// daily rate limit (count rows created in the last 24h for a user) — see
/// lib/rateLimit.ts and plan.md's "simple per-user daily cap" decision.
model AiGenerationLog {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Recipe {
  id           String   @id @default(cuid())
  title        String
  ingredients  String[]
  instructions String
  aiGenerated  Boolean  @default(false)
  imageUrl     String?
  createdBy    String
  createdAt    DateTime @default(now())

  // Intentionally left as the default (Restrict), not an oversight: protects authored
  // recipe content from being silently deleted when the creator's account is removed.
  creator         User            @relation(fields: [createdBy], references: [id])
  savedBy         SavedRecipe[]
  mealPlanEntries MealPlanEntry[]

  @@index([createdBy])
}

model SavedRecipe {
  userId   String
  recipeId String
  savedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
  @@index([recipeId])
}

model MealPlan {
  id            String   @id @default(cuid())
  userId        String
  weekStartDate DateTime

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries MealPlanEntry[]

  @@index([userId])
}

enum MealType {
  breakfast
  lunch
  dinner
}

model MealPlanEntry {
  id         String   @id @default(cuid())
  mealPlanId String
  recipeId   String
  dayOfWeek  Int
  mealType   MealType

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([mealPlanId, dayOfWeek, mealType])
  @@index([mealPlanId])
  @@index([recipeId])
}
